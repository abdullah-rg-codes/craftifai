{
  "name": "@craftifai/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "create": "tsx ./src/cli.ts createDatabase",
    "drop": "tsx ./src/cli.ts dropDatabase",
    "migrate": "tsx ./src/migrate.ts up",
    "migrate:down": "tsx ./src/migrate.ts down"
  },
  "dependencies": {
    "dbmate": "^2.26.0",
    "pg": "^8.15.6",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/pg": "^8.15.3",
    "typescript": "^5.8.3"
  }
}
