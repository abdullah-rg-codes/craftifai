{
  "name": "craftifai",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant AI control plane — CraftifAI assignment",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --exclude **/foundation.test.ts --exclude **/credits.test.ts",
    "test:integration": "node -e \"for (const key of ['DATABASE_URL','DATABASE_ADMIN_URL','REDIS_URL','SESSION_SECRET','WEBHOOK_SECRET']) if (!process.env[key]) throw new Error('Missing integration-test environment variable: ' + key)\" && vitest run --fileParallelism=false apps/api/test/foundation.test.ts apps/api/test/credits.test.ts",
    "test:watch": "vitest",
    "dev": "pnpm --filter api dev & pnpm --filter web dev",
    "db:migrate:down": "pnpm --filter db migrate:down",
    "db:migrate": "pnpm --filter db run migrate",
    "db:drop": "pnpm --filter db drop",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down -v",
    "compose:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "vitest": "^3.2.4"
  }
}
